#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &kp Q  &kp W  &kp E    &kp R               &kp T    &kp Y  &kp U        &kp I      &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT    &kp A  &kp S  &kp D    &kp F               &kp G    &kp H  &kp J        &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C    &kp V               &kp B    &kp N  &kp M        &kp COMMA  &kp DOT  &kp FSLH  &kp EXCLAMATION
                                &kp ESC  &mt LEFT_WIN SPACE  &mo 1    &mo 2  &lt 1 ENTER  &kp RALT
            >;
        };

        layer_1 {
            bindings = <
&trans    &trans  &trans  &trans     &kp LBKT   &kp RBKT    &kp PLUS   &kp N7  &kp N8  &kp N9  &kp FSLH   &kp BSPC
&kp CAPS  &trans  &trans  &trans     &trans     &trans      &kp MINUS  &kp N4  &kp N5  &kp N6  &kp COLON  &kp EQUAL
&trans    &trans  &trans  &kp LC(C)  &kp LC(V)  &trans      &kp N0     &kp N1  &kp N2  &kp N3  &kp DOT    &kp KP_NUMLOCK
                          &trans     &trans     &trans      &trans     &trans  &trans
            >;

            label = "num";
        };

        layer_2 {
            bindings = <
&kp AT_SIGN  &kp CARET        &kp PERCENT      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &kp EQUAL  &kp LESS_THAN   &kp GREATER_THAN  &trans           &trans  &kp BSPC
&trans       &bt BT_CLR_ALL   &bt BT_SEL 0     &bt BT_SEL 1          &bt BT_SEL 2           &bt BT_SEL 3    &trans     &trans          &kp UP_ARROW      &trans           &trans  &trans
&trans       &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI       &trans                 &trans          &trans     &kp LEFT_ARROW  &kp DOWN_ARROW    &kp RIGHT_ARROW  &trans  &trans
                                               &trans                &trans                 &trans          &trans     &trans          &trans
            >;

            label = "sym";
        };
    };
};
